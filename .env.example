APP_PASSWORD=change-me
DATA_DIR=./data
AUDIOBOOKS_DIR=./audiobooks

MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=苏打
MIMO_TTS_CLONE_MODEL=mimo-v2.5-tts-voiceclone
MIMO_TTS_DESIGN_MODEL=mimo-v2.5-tts-voicedesign
# 同模型的正式生成、试听和音色设计共用请求频率与冷却；同账号其他应用的请求需自行计入
MIMO_TTS_RPM=60
# 每次调用等待限流恢复的时间窗口；耗尽后报错，单次 HTTP 请求超时仍为 300 秒
MIMO_TTS_RATE_LIMIT_WAIT_SECONDS=180

TTS_DEFAULT_PROVIDER=mlx_audio
MLX_AUDIO_BASE_URL=http://127.0.0.1:8100
MLX_AUDIO_TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-Base-8bit
MLX_AUDIO_LANGUAGE=chinese
MLX_AUDIO_MAX_TOKENS=4096
MLX_AUDIO_CHUNK_TARGET_CHARS=300
MLX_AUDIO_CHUNK_MAX_CHARS=450

# OpenRouter 的 API Key 填在 LLM_API_KEY，不要复用 MIMO_API_KEY
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_MAX_COMPLETION_TOKENS=16384
# 留空使用模型默认推理策略；仅在模型明确要求时填写 low/medium/high/max 等值
LLM_REASONING_EFFORT=
# 读音检查每批最多请求次数；模型偶发输出退化时自动重新请求
LLM_MAX_ATTEMPTS=3
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8000
OPENROUTER_TITLE=Book TTS
# 同模型服务商异常时允许 OpenRouter 切换到其他健康服务商
OPENROUTER_ALLOW_FALLBACKS=true
# 优先使用的服务商（逗号分隔的 slug，留空为 OpenRouter 默认路由）；设为 false 的 ALLOW_FALLBACKS 会只用这里列出的服务商
OPENROUTER_PROVIDER_ORDER=
# 只允许的量化精度（逗号分隔，留空不限），用于排除 fp4/nvfp4 等低精度版本
OPENROUTER_QUANTIZATIONS=

TTS_CONCURRENCY=3
TTS_MAX_ATTEMPTS=3
WORKER_LEASE_SECONDS=900
POLL_INTERVAL_SECONDS=2
